	(text "The brain: STM32U575 microcontroller"
		(exclude_from_sim no)
		(at 10.16 15.24 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c07ba669-f878-5add-9edb-8278f69d221a")
	)
	(text_box "DECOUPLING  C1-C7\nTiny local energy stores beside the chip's power pins; they keep 3.0 V steady when the chip draws sudden gulps."
		(exclude_from_sim no)
		(at 10.16 20.32 0)
		(size 71.12 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "5a1c40ef-b31c-563b-9e95-ecb771d229f8")
	)
	(text_box "THE BRAIN  U1\nHears the microphone, shifts ultrasound down into hearing range, drives the speaker, and runs the button, light, battery checks and USB updates. Right-side flags name where each pin goes."
		(exclude_from_sim no)
		(at 198.12 20.32 0)
		(size 81.28 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "27d206f9-476f-5108-b317-49a3cf7d10cd")
	)
	(text_box "OWN POWER CONVERTER  L1, C8, C9\nThe chip's built-in efficient supply for its core (1.1 V); the only switching supply in the pod."
		(exclude_from_sim no)
		(at 198.12 41.91 0)
		(size 81.28 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "51a458d7-e585-5101-b679-61f0d86264c6")
	)
	(text_box "BUTTON  SW1, R10\nPress = 3.0 V reaches PA0 and wakes the brain; R10 holds it low otherwise."
		(exclude_from_sim no)
		(at 198.12 59.69 0)
		(size 81.28 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "be9cbe1f-65cd-5205-9f09-7837c11cd819")
	)
	(text_box "CLOCK  Y1, C11, C12\nA 32.768 kHz crystal: the chip's accurate time base."
		(exclude_from_sim no)
		(at 198.12 74.93 0)
		(size 81.28 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "c3eb1fe4-1dad-52db-a532-eecf6c0e0d54")
	)
	(text_box "BOOT AND RESET  R1, C10\nR1 makes the chip start its own program; C10 keeps the reset line quiet."
		(exclude_from_sim no)
		(at 198.12 88.9 0)
		(size 81.28 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "ae73d148-a670-5c85-bddb-1e0fa225ebf6")
	)
	(text_box "TEST PADS  TP1-TP10\nGold dots for a programmer (SWDIO, SWCLK, NRST) or a probe. TP7 prints debug text; TP8-TP10 are a hand-wire fallback for the microphone clock."
		(exclude_from_sim no)
		(at 104.14 152.4 0)
