			)
			(justify left top)
		)
		(uuid "bfb00819-9544-5d6d-bd6d-154e20d907fa")
	)
	(text_box "SAFE OFF  R3-R6\nHold every switch OFF while the brain is starting up or resetting."
		(exclude_from_sim no)
		(at 223.52 46.99 0)
		(size 63.5 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
