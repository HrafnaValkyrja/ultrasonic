			)
			(justify left top)
		)
		(uuid "3d911d67-e104-5fa1-9ea6-a1361c04748a")
	)
	(text_box "SELF-CHECK  R21, R22, C22\nA 0.1 ohm resistor measures speaker current, so the pod can test its own speaker."
		(exclude_from_sim no)
		(at 223.52 67.31 0)
		(size 63.5 16.51)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
