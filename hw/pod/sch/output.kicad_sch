			)
			(justify left top)
		)
		(uuid "4b025c79-cba6-59da-a5ba-510bb9c894aa")
	)
	(text_box "C14  22 uF\nLocal reservoir for the speaker's current peaks."
		(exclude_from_sim no)
		(at 223.52 88.9 0)
