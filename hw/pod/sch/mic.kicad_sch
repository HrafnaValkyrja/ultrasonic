	(text_box "ULTRASONIC MICROPHONE  U2\nListens through a 0.6 mm pinhole in the board and a mesh-covered hole in the lid. It sends sound to the brain as a fast stream of 1s and 0s (PDM) timed by MIC_CLK."
		(exclude_from_sim no)
		(at 127 22.86 0)
		(size 88.9 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
