			)
			(justify left top)
		)
		(uuid "ff7e08e7-0377-5d5d-9d21-4e2ac5ac7e7f")
	)
	(text_box "POWER SWITCH\nThe brain powers the mic from a pin (MIC_VDD), so it is fully off when the pod is off. C13 steadies that supply."
