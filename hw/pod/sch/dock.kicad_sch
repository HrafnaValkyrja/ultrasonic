			)
			(justify left top)
		)
		(uuid "24820456-7948-5fb7-87b1-d137204a2348")
	)
	(text_box "SMOOTHING  C15\nA small reservoir that steadies the incoming dock power (rated 25 V for margin)."
		(exclude_from_sim no)
