		(uuid "a7f85176-bc16-512c-8fcf-bcc5cd89e1d3")
	)
	(text "Rail markers (drawing aids for the checker, not parts)"
		(exclude_from_sim no)
		(at 17.78 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "fc1d09cc-2d61-5729-addc-c469452586b8")
	)
	(text_box "THE DOCK\nFive gold pads touch the magnetic charging dock: 5 V power (VBUS), ground, the two USB data lines (D+ / D-) and CC, the line that tells a USB-C charger 'I am a device, send 5 V'."
		(exclude_from_sim no)
		(at 139.7 22.86 0)
		(size 76.2 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "b2e8a284-964b-5359-b889-6b008d307d6b")
	)
	(text_box "SPARK GUARD  D5\nSoaks up static zaps right where they land, on the exposed power contact."
		(exclude_from_sim no)
		(at 139.7 43.18 0)
		(size 76.2 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "43998b9a-8e8c-5c19-970e-0857652dc4b1")
	)
	(text_box "ONE-WAY VALVE  D4\nLets dock power in but stops it flowing backwards if the pod is docked the wrong way."
		(exclude_from_sim no)
		(at 139.7 59.69 0)
		(size 76.2 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "94424d97-e395-58e4-84f7-ff34b95e07ce")
	)
	(text_box "DOCK DETECT  R12 / R13\nHalves the dock voltage so the brain can safely see 'I am docked'."
		(exclude_from_sim no)
		(at 139.7 76.2 0)
		(size 76.2 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type color)
			(color 255 248 225 1)
		)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "341f7892-3f6e-5650-8606-04fd81e46286")
	)
	(text_box "USB GUARD  U6\nSpark protection for the two USB data lines on their way to the brain."
		(exclude_from_sim no)
		(at 139.7 92.71 0)
		(size 76.2 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
