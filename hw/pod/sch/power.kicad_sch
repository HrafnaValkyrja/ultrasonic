	)
	(text_box "TEMPERATURE CHECK  RT1 / J9\nA heat-sensitive resistor (or one taped to the cell via J9) tells the charger the battery temperature."
		(exclude_from_sim no)
		(at 190.5 41.91 0)
		(size 88.9 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
